ARENA_SNAPSHOT=
# Optional separate verified CC0 research package; bundled package is the default.
ARENA_OPEN_FOOTBALL=
# Optional current-provider publications. The API reads verified snapshots;
# only the separate lakehouse polling worker holds provider credentials.
ARENA_LIVE_WORKSPACE=data/live
ARENA_STATE=data/copilot
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text:137m-v1.5-fp16
# Optional local MLflow SQL tracking store.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=arena-copilot-local
# Total inference request budget; internally bounded to 10–300 seconds.
ARENA_REQUEST_TIMEOUT_SECONDS=180
